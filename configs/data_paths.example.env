# Copy this file to configs/data_paths.env on the server and edit paths.
# Do not commit configs/data_paths.env.

DATA_ROOT=/path/to/pkno_data

# Stage 0 official/KNO-aligned datasets.
BURGERS_ROOT=burgers
BURGERS_FILE=burgers/burgers_data_R10.mat

NAVIER_STOKES_ROOT=navier_stokes
NS2D_FILE=navier_stokes/ns_data.mat
NS2D_V1E3_FILE=navier_stokes/ns_V1e-3_N5000_T50.mat
NS2D_V1E4_FILE=navier_stokes/ns_V1e-4_N10000_T30.mat
NS2D_V1E5_FILE=navier_stokes/ns_V1e-5_N1200_T20.mat

SHALLOW_WATER_ROOT=shallow_water
SHALLOW_WATER_FILE=shallow_water/shallow_water_data.mat

RAYLEIGH_BENARD_ROOT=rayleigh_benard
RAYLEIGH_BENARD_FILE=rayleigh_benard/rayleigh_benard_data.h5

# Later parameterized datasets.
PDEBENCH_ROOT=pdebench

# External code roots.
KOOPMANLAB_ROOT=external/KoopmanLab
PKNN_REFERENCE_ROOT=external/pknn_reference
PDEBENCH_CODE_ROOT=external/PDEBench
